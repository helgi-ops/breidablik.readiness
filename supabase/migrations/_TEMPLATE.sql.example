-- ─────────────────────────────────────────────────────────────────────────
-- MicroPulse migration template
--
-- Copy this file (rename to YYYYMMDDHHMMSS_<name>.sql) when creating a new
-- migration that introduces a public-schema table. Follows the Supabase
-- Data API policy change announced May 2026:
--
--   - May 30, 2026: New Supabase projects no longer auto-grant Data API
--     access to public-schema tables.
--   - October 30, 2026: Same enforcement applied to ALL existing projects,
--     including MicroPulse's production project.
--
-- After Oct 30, every new table created in public/ MUST include explicit
-- GRANT statements before supabase-js / PostgREST / GraphQL can see it.
-- Without GRANT, the API returns "42501" permission errors.
--
-- Existing tables in the project keep their current grants — only NEW
-- tables created via future migrations are affected.
--
-- THIS TEMPLATE provides the 4 building blocks every new public table
-- needs in MicroPulse:
--   1. Table DDL
--   2. Indexes
--   3. Grants (anon / authenticated / service_role)
--   4. RLS + policies
-- ─────────────────────────────────────────────────────────────────────────


-- ─── 1. Table DDL ───────────────────────────────────────────────────────
create table if not exists public.your_table (
  id uuid primary key default gen_random_uuid(),
  team_id uuid references public.teams(id) on delete set null,
  player_id uuid references public.players(id) on delete cascade,
  -- ... your columns ...
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);


-- ─── 2. Indexes ─────────────────────────────────────────────────────────
create index if not exists your_table_team_idx
  on public.your_table (team_id);
create index if not exists your_table_player_idx
  on public.your_table (player_id);


-- ─── 3. Grants ──────────────────────────────────────────────────────────
-- Choose ONE pattern based on access scope. Comment out the unused ones.

-- Pattern A: Coach/staff read+write, no public anon access (most common
-- for MicroPulse tables — coach-owned data, players see their own rows
-- via separate RLS policies).
grant select, insert, update, delete on public.your_table to authenticated;
grant select, insert, update, delete on public.your_table to service_role;

-- Pattern B: Read-only public table (e.g. drill library, exercise
-- library). Use sparingly — most data should NOT be anon-readable.
-- grant select on public.your_table to anon;
-- grant select, insert, update, delete on public.your_table to authenticated;
-- grant select, insert, update, delete on public.your_table to service_role;

-- Pattern C: Server-only table (e.g. internal job queue, audit log).
-- grant select, insert, update, delete on public.your_table to service_role;
-- (no grants to authenticated → table invisible to client SDK)


-- ─── 4. RLS + policies ──────────────────────────────────────────────────
alter table public.your_table enable row level security;

-- Coaches see their team's rows
create policy "coaches_select_their_team"
  on public.your_table
  for select
  to authenticated
  using (
    exists (
      select 1 from public.profiles p
      where p.id = auth.uid()
        and lower(coalesce(p.role, '')) in ('coach','admin','staff')
        and (
          p.team_id = your_table.team_id
          or exists (
            select 1 from public.coach_teams ct
            where ct.coach_id = auth.uid()
              and ct.team_id = your_table.team_id
          )
        )
    )
  );

-- Players see their own rows (if applicable)
create policy "players_select_own"
  on public.your_table
  for select
  to authenticated
  using (
    exists (
      select 1 from public.profiles p
      where p.id = auth.uid()
        and p.player_id = your_table.player_id
    )
  );

-- Add insert/update/delete policies as needed. Repeat the EXISTS pattern.


-- ─── 5. Trigger to auto-update updated_at (optional) ────────────────────
create or replace function public.your_table_set_updated_at()
  returns trigger language plpgsql as $$
begin
  new.updated_at := now();
  return new;
end;
$$;

create trigger your_table_set_updated_at
  before update on public.your_table
  for each row execute function public.your_table_set_updated_at();


-- ─── 6. Comments for self-documenting schema ───────────────────────────
comment on table public.your_table is
  'Short description of what this table holds + which feature owns it.';


-- ─────────────────────────────────────────────────────────────────────────
-- Common pitfalls:
--
-- ❌ Forgetting grants → table works in development (where you've been
--     using service_role) but fails for users in production with "42501".
--
-- ❌ Granting to anon for non-public data → leaks data to anyone with
--     the project's public anon key.
--
-- ❌ Enabling RLS without policies → all queries return empty (RLS denies
--     by default).
--
-- ❌ Creating policies before granting → RLS allows it but the role
--     doesn't have base permissions, so still 42501.
--
-- ✅ Always do grants BEFORE RLS, RLS BEFORE policies. Order matters.
--
-- See: https://supabase.com/docs/guides/database/postgres/row-level-security
-- ─────────────────────────────────────────────────────────────────────────
