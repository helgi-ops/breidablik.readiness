# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# FUSE filesystem artifacts (e.g. from sshfs/network mounts) — never source
.fuse_hidden*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Sport science research library (large binary corpus, not source) ──
research/

# ── Word/Excel/LibreOffice temp + lockfiles ──
~$*
.~lock.*
lu*.tmp

# ── Generated deliverable docs (live in workspace, not source) ──
MicroPulse Coach Guide.pdf
MicroPulse-App-Uppsetning.pdf
MicroPulse-Pilot-Samningur*.docx
MicroPulse-References-*.docx
MicroPulse-References-*.md
MicroPulse-Sport-Science-References.docx
MicroPulse-Sport-Science-References.md

# Licensed sample data (StatsBomb IQ / Wyscout exports) — never commit; READMEs (*.md) stay tracked
docs/samples/statsbomb/*.csv
docs/samples/statsbomb/league-team-stats/
docs/samples/wyscout/*.xlsx
docs/samples/wyscout/*.xls
